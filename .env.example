# Site URL (canonical / Open Graph / sitemap). Use your Netlify domain or custom domain.
NEXT_PUBLIC_SITE_URL=https://mhentor.netlify.app

# Google Search Console HTML tag verification code (content value only)
# NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=wUP3iEblxKHrvtwRk_39AidDO6zPQXnWkKbg1lVnabo

# ===========================================
# AI Chat – floating chatbot
# ===========================================
# Copy to .env.local. Never commit real keys.

NEXT_PUBLIC_CHAT_API_URL=/api/chat

# Server-only keys (preferred)
HUGGINGFACE_API_KEY=
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
GEMINI_API_KEY=
GROQ_API_KEY=

