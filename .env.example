# ===========================================
# AI Chat – floating chatbot
# ===========================================
# Copy to .env.local. Never commit real keys.

# Backend chat API (Next.js route or external)
NEXT_PUBLIC_CHAT_API_URL=/api/chat

# Server-only keys (preferred)
HUGGINGFACE_API_KEY=your_huggingface_token_here
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
GEMINI_API_KEY=
GROQ_API_KEY=

# Booking link (Google Calendar, Calendly, etc.)
# NEXT_PUBLIC_BOOKING_URL=
